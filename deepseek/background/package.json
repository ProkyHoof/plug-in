{
  "name": "dsh-background-image",
  "version": "1.0.0",
  "description": "DeepSeek Harness 背景图片插件：本地导入、图片链接、透明度、模糊和遮罩调节",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "VALIDATION.md", "docs/*.png"],
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "check": "npm test",
    "prepack": "npm run build"
  },
  "dependencies": { "@deepseek-ai/schemastery": "3.18.5" },
  "devDependencies": { "@deepseek-ai/cordis": "4.0.5", "esbuild": "^0.25.0", "jsdom": "^26.0.0", "react": "^18.3.1", "react-dom": "^18.3.1" }
}
